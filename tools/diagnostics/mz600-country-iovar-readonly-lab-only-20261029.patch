diff --git a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/cfg80211.c b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/cfg80211.c
index 4ea41980b..c0ee34162 100644
--- a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/cfg80211.c
+++ b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/cfg80211.c
@@ -8527,6 +8527,27 @@ struct brcmf_cfg80211_info *brcmf_cfg80211_attach(struct brcmf_pub *drvr,
 		goto wiphy_unreg_out;
 	}
 
+	/* LAB ONLY: bounded read-back of runtime Broadcom country identity.
+	 * No firmware settings, cfg80211 state, or calibration are modified.
+	 */
+	if (drvr->bus_if->chip == BRCM_CC_4329_CHIP_ID) {
+		struct brcmf_fil_country_le cc = {};
+		int country_err;
+
+		country_err = brcmf_fil_iovar_data_get(ifp, "country", &cc,
+						       sizeof(cc));
+		if (country_err) {
+			brcmf_info("MZ600_COUNTRY_READ err=%d\n",
+				  country_err);
+		} else {
+			brcmf_info(
+				  "MZ600_COUNTRY_READ err=0 abbrev=%c%c ccode=%c%c regrev=%u\n",
+				  cc.country_abbrev[0], cc.country_abbrev[1],
+				  cc.ccode[0], cc.ccode[1],
+				  le32_to_cpu(cc.rev));
+		}
+	}
+
 	/* If cfg80211 didn't disable 40MHz HT CAP in wiphy_register(),
 	 * setup 40MHz in 2GHz band and enable OBSS scanning.
 	 */
