From 6f3efe860f8872ab348c7cfc269df89fd912d561 Mon Sep 17 00:00:00 2001
From: XoomLinux7 RFC draft <rfc-draft@invalid.example>
Date: Tue, 27 Oct 2026 20:49:33 -0400
Subject: [PATCH 1/4] wifi: brcmfmac: use legacy channel list on BCM4329

Some older BCM4329 firmware rejects the 'chanspecs' iovar with
BCME_UNSUPPORTED, while WLC_GET_VALID_CHANNELS returns valid
firmware channel numbers. Without a fallback, the advertised wiphy
channels are incomplete and ordinary 2.4/5 GHz scans fail.

On precisely that firmware error and chipset, consume the bounded
legacy channel list. Disable channels not reported by firmware and
constrain bandwidth to 20 MHz. For allowed 20 MHz channels, query
the optional firmware per_chan_info restrictions, as the normal
chanspec path does, and add radar/passive flags when supported.
Never enable a channel or clear cfg80211 restrictions. Do not alter
the normal chanspec path or any other Broadcom device.

A BCM4329 V31 laboratory build with related legacy fallback completed
normal scans, WPA2 and internet access on a Motorola Xoom MZ600.
This cleaned source variant requires its own physical validation.

Assisted-by: ChatGPT:GPT-6 [Desktop Commander]
On firmware without per_chan_info, retain fail-closed NO_IR on
5 GHz channels and avoid repeating unsupported IOCTLs. This is
not a country override or permission to transmit.
---
 .../broadcom/brcm80211/brcmfmac/cfg80211.c    | 108 +++++++++++++++++-
 1 file changed, 107 insertions(+), 1 deletion(-)

diff --git a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/cfg80211.c b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/cfg80211.c
index 0b55d4458..2f4b19443 100644
--- a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/cfg80211.c
+++ b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/cfg80211.c
@@ -6992,6 +6992,108 @@ static void brcmf_update_bw40_channel_flag(struct ieee80211_channel *channel,
 	}
 }
 
+/* Older BCM4329 firmware exposes a channel-number list, not 'chanspecs'.
+ * Keep existing cfg80211 restrictions and assume only 20 MHz support.
+ */
+static int brcmf_bcm4329_legacy_channels(struct brcmf_cfg80211_info *cfg,
+					 u8 *pbuf)
+{
+	struct brcmf_pub *drvr = cfg->pub;
+	struct brcmf_if *ifp = brcmf_get_ifp(drvr, 0);
+	struct wiphy *wiphy = cfg_to_wiphy(cfg);
+	struct brcmf_chanspec_list *list = (void *)pbuf;
+	struct ieee80211_supported_band *band;
+	u32 count, max_count, chan, chaninfo, i, j, k;
+	struct brcmu_chan ch = {};
+	struct ieee80211_channel *channel;
+	bool supported, per_chan_available = true;
+	int err, chan_err;
+
+	max_count = (BRCMF_DCMD_MEDLEN - sizeof(list->count)) /
+		    sizeof(list->element[0]);
+	memset(pbuf, 0, BRCMF_DCMD_MEDLEN);
+	list->count = cpu_to_le32(max_count);
+	err = brcmf_fil_cmd_data_get(ifp, BRCMF_C_GET_VALID_CHANNELS,
+				     pbuf, BRCMF_DCMD_MEDLEN);
+	if (err)
+		return err;
+
+	count = le32_to_cpu(list->count);
+	if (!count || count > max_count)
+		return -EINVAL;
+	for (i = 0; i < count; i++) {
+		chan = le32_to_cpu(list->element[i]);
+		if (!((chan >= 1 && chan <= 14) ||
+		      (chan >= 30 && chan <= 196)))
+			return -EINVAL;
+	}
+
+	for (i = 0; i < NUM_NL80211_BANDS; i++) {
+		band = wiphy->bands[i];
+		if (!band || (i != NL80211_BAND_2GHZ &&
+			      i != NL80211_BAND_5GHZ))
+			continue;
+		for (j = 0; j < band->n_channels; j++) {
+			supported = false;
+			for (k = 0; k < count; k++) {
+				if (band->channels[j].hw_value ==
+				    le32_to_cpu(list->element[k])) {
+					supported = true;
+					break;
+				}
+			}
+			if (!supported) {
+				band->channels[j].flags |= IEEE80211_CHAN_DISABLED;
+				continue;
+			}
+			/* Preserve any restrictions already applied by cfg80211. */
+			channel = &band->channels[j];
+			channel->flags |= IEEE80211_CHAN_NO_HT40 |
+				IEEE80211_CHAN_NO_80MHZ |
+				IEEE80211_CHAN_NO_160MHZ;
+
+			/* Match the normal chanspec path's firmware restrictions.
+			 * Older firmware may omit this optional query.
+			 */
+			if (per_chan_available) {
+				ch.chnum = channel->hw_value;
+				ch.band = (band->band == NL80211_BAND_2GHZ) ?
+					BRCMU_CHAN_BAND_2G : BRCMU_CHAN_BAND_5G;
+				ch.bw = BRCMU_CHAN_BW_20;
+				ch.sb = BRCMU_CHAN_SB_NONE;
+				cfg->d11inf.encchspec(&ch);
+				chaninfo = ch.chspec;
+				chan_err = brcmf_fil_bsscfg_int_query(ifp,
+								      "per_chan_info",
+								      &chaninfo);
+				if (!chan_err) {
+					if (chaninfo & WL_CHAN_RADAR)
+						channel->flags |=
+							IEEE80211_CHAN_RADAR |
+							IEEE80211_CHAN_NO_IR;
+					if (chaninfo & WL_CHAN_PASSIVE)
+						channel->flags |=
+							IEEE80211_CHAN_NO_IR;
+				} else if (chan_err == -EOPNOTSUPP ||
+					   chan_err == -EBADE) {
+					/* Early firmware lacks per-channel metadata. */
+					per_chan_available = false;
+				}
+			} else {
+				chan_err = -EOPNOTSUPP;
+			}
+			/* Never infer permission to initiate radiation when the
+			 * legacy firmware cannot describe a 5 GHz channel.
+			 * Leave cfg80211/regulatory to apply its additional rules.
+			 */
+			if (chan_err && band->band == NL80211_BAND_5GHZ)
+				channel->flags |= IEEE80211_CHAN_NO_IR;
+		}
+	}
+
+	return 0;
+}
+
 static int brcmf_construct_chaninfo(struct brcmf_cfg80211_info *cfg,
 				    u32 bw_cap[])
 {
@@ -7018,7 +7120,11 @@ static int brcmf_construct_chaninfo(struct brcmf_cfg80211_info *cfg,
 	err = brcmf_fil_iovar_data_get(ifp, "chanspecs", pbuf,
 				       BRCMF_DCMD_MEDLEN);
 	if (err) {
-		bphy_err(drvr, "get chanspecs error (%d)\n", err);
+		if (err == -EBADE &&
+		    drvr->bus_if->chip == BRCM_CC_4329_CHIP_ID)
+			err = brcmf_bcm4329_legacy_channels(cfg, pbuf);
+		else
+			bphy_err(drvr, "get chanspecs error (%d)\n", err);
 		goto fail_pbuf;
 	}
 
