+/*
+ * XOOM_MMC2_V020: experimental runtime profile, NEVER a universal quirk.
+ * mode 0: standard Linux behavior; mode 1: six Motorola embedded capabilities.
+ * Values may change in RAM; they take effect only on a NEW card enumeration.
+ */
+static unsigned int xoom_mmc2_profile;
+static int xoom_mmc2_profile_set(const char *val, const struct kernel_param *kp)
+{
+    unsigned int value;
+    int rc = kstrtouint(val, 0, &value);
+    if (rc)
+        return rc;
+    if (value > 1)
+        return -EINVAL;
+    return param_set_uint(val, kp);
+}
+static const struct kernel_param_ops xoom_mmc2_profile_ops = {
+    .set = xoom_mmc2_profile_set,
+    .get = param_get_uint,
+};
+module_param_cb(xoom_mmc2_profile, &xoom_mmc2_profile_ops,
+                &xoom_mmc2_profile, 0600);
 
