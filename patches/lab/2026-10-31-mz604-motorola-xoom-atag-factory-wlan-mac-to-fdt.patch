 #define NR_BANKS 16
 
+/*
+ * Motorola Xoom bootloader supplies factory WLAN address in the vendor
+ * Stingray ATAG on Stingray/Wingray variants. Deliver it to the upstream
+ * SDIO WLAN node, with no board-shared or generated fallback.
+ */
+#define ATAG_STINGRAY_MAC 0x57464d41
+#define MOTOROLA_XOOM_WIFI_PATH "/mmc@c8000200/wifi@1"
+
+static void xoom_wifi_mac_atag_to_fdt(void *fdt, const struct tag *atag)
+{
+	const unsigned char *mac = (const unsigned char *)&atag->u;
+	unsigned char any = 0;
+	int wifi, i;
+
+	/* Header of two words plus two payload words hold six address bytes. */
+	if (atag->hdr.size < 4)
+		return;
+
+	/* Reject tags on non-Xoom Tegra boards. */
+	if (fdt_node_check_compatible(fdt, 0, "motorola,xoom"))
+		return;
+
+	for (i = 0; i < 6; i++)
+		any |= mac[i];
+
+	if (!any || (mac[0] & 1))
+		return;
+	/* Broadcom placeholder observed with the generic firmware. */
+	if (mac[0] == 0x00 && mac[1] == 0x90 && mac[2] == 0x4c &&
+		((mac[3] == 0x12 && mac[4] == 0x34 && mac[5] == 0x56) ||
+		 (mac[3] == 0x00 && mac[4] == 0x00 && mac[5] == 0x00)))
+		return;
+
+	wifi = fdt_path_offset(fdt, MOTOROLA_XOOM_WIFI_PATH);
+	if (wifi < 0)
+		return;
+
+	fdt_setprop(fdt, wifi, "local-mac-address", mac, 6);
+}
