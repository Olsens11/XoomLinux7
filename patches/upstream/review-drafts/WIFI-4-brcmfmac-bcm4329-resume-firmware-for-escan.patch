+/* BCM4329 firmware may bring its interface down while MPC is enabled.
+ * Leave the idle MPC policy intact and restore firmware readiness when
+ * another station scan is requested.
+ */
+static s32 brcmf_bcm4329_prepare_escan(struct brcmf_if *ifp)
+{
+	u32 up;
+	s32 err;
+
+	if (ifp->drvr->bus_if->chip != BRCM_CC_4329_CHIP_ID ||
+	    ifp->ifidx || ifp->bsscfgidx || !ifp->vif ||
+	    ifp->vif->wdev.iftype != NL80211_IFTYPE_STATION)
+		return 0;
+
+	err = brcmf_fil_cmd_int_get(ifp, BRCMF_C_GET_UP, &up);
+	if (err || up == 1)
+		return err;
+	if (up != 0)
+		return -EIO;
+
+	err = brcmf_fil_cmd_int_set(ifp, BRCMF_C_UP, 1);
+	if (err)
+		return err;
+
+	err = brcmf_fil_cmd_int_get(ifp, BRCMF_C_GET_UP, &up);
+	if (err)
+		return err;
+
+	return up == 1 ? 0 : -EIO;
+}
