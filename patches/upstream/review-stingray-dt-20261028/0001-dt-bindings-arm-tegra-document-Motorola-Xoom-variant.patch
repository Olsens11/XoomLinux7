From 6a934f67836abcafb47d765f723ec7615f9f690b Mon Sep 17 00:00:00 2001
From: XoomLinux7 RFC draft <rfc-draft@invalid.example>
Date: Tue, 27 Oct 2026 21:38:45 -0400
Subject: [PATCH 1/3] dt-bindings: arm: tegra: document Motorola Xoom variants

The Tegra board schema does not describe the existing Wingray root
compatible tuple. The new Stingray variant uses the same Xoom family
fallback.

Document both board variants and their common Motorola Xoom and
Tegra20 compatible entries without changing the hardware description.

Assisted-by: ChatGPT:GPT-6
---
 Documentation/devicetree/bindings/arm/tegra.yaml | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/Documentation/devicetree/bindings/arm/tegra.yaml b/Documentation/devicetree/bindings/arm/tegra.yaml
index ca311262c..d507efb2a 100644
--- a/Documentation/devicetree/bindings/arm/tegra.yaml
+++ b/Documentation/devicetree/bindings/arm/tegra.yaml
@@ -46,6 +46,13 @@ properties:
       - items:
           - const: acer,picasso
           - const: nvidia,tegra20
+      - description: Motorola Xoom Tegra20 family
+        items:
+          - enum:
+              - motorola,stingray
+              - motorola,wingray
+          - const: motorola,xoom
+          - const: nvidia,tegra20
       - description: Motorola Mot based Device family
         items:
           - enum:
-- 
