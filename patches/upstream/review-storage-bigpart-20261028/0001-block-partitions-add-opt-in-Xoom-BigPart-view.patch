From 655385d37f3e382e836f90f9cd4230089e1e743a Mon Sep 17 00:00:00 2001
From: XoomLinux7 unsigned RFC <rfc-draft@invalid.example>
Date: Wed, 28 Oct 2026 03:51:42 -0400
Subject: [PATCH] block: partitions: add opt-in Xoom BigPart view

Classic Motorola Xoom BigPart changes the in-memory extents of GPT
partitions 8 through 10 without rewriting the factory GPT.

Preserve the first seven entries and the userdata end boundary.
Reject unexpected partition layouts before registering the remap.
Leave the ordinary GPT path unchanged when not opted in.

Require xoom_bigpart=1 on a matching Stingray CDMA eMMC controller,
with exact device capacity and CRC-validated factory partition map.
If an opted-in disk has a missing or invalid GPT, fail closed.

The existing Tegra MMC alternative_gpt_sector operation already
locates the OEM relocated GPT with the gpt boot option. Do not
reimplement sector overrides or add an undocumented Devicetree
policy property.

This unsigned RFC still needs exact-source physical tests, unusual
error-path validation and block maintainer review.

Assisted-by: ChatGPT:GPT-6 [Desktop Commander]
---
 .../admin-guide/kernel-parameters.txt         |   9 ++
 block/partitions/Kconfig                      |  14 ++
 block/partitions/efi.c                        | 141 ++++++++++++++++++
 3 files changed, 164 insertions(+)

diff --git a/Documentation/admin-guide/kernel-parameters.txt b/Documentation/admin-guide/kernel-parameters.txt
index 0a1abed1b..6ec9afb24 100644
--- a/Documentation/admin-guide/kernel-parameters.txt
+++ b/Documentation/admin-guide/kernel-parameters.txt
@@ -8579,6 +8579,15 @@ Kernel parameters
 			default x2apic cluster mode on platforms
 			supporting x2apic.
 
+	xoom_bigpart=	[KNL,ARM] Opt in to the classic Motorola Xoom
+			BigPart in-memory partition mapping on an exact
+			Stingray MZ600 factory eMMC. Requires
+			CONFIG_MOTOROLA_XOOM_BIGPART=y and gpt on the
+			kernel command line. Default is disabled.
+			Value: 1 to enable, 0 to disable.
+			Does not write the on-disk GPT; never use a
+			stock-geometry recovery to write BigPart p8.
+
 	xen_512gb_limit		[KNL,X86-64,XEN]
 			Restricts the kernel running paravirtualized under Xen
 			to use only up to 512 GB of RAM. The reason to do so is
diff --git a/block/partitions/Kconfig b/block/partitions/Kconfig
index ce17e4145..0da2ce465 100644
--- a/block/partitions/Kconfig
+++ b/block/partitions/Kconfig
@@ -255,6 +255,20 @@ config EFI_PARTITION
 	  Say Y here if you would like to use hard disks under Linux which
 	  were partitioned using EFI GPT.
 
+config MOTOROLA_XOOM_BIGPART
+	bool "Opt-in classic Motorola Xoom BigPart partition compatibility"
+	depends on EFI_PARTITION && OF && ARCH_TEGRA
+	help
+	  Support the legacy Motorola Xoom BigPart logical partition
+	  mapping on the factory-layout Stingray CDMA eMMC. This option
+	  does not modify the on-disk GPT or write to storage.
+
+	  In addition to this build option, the operator must supply
+	  xoom_bigpart=1 and gpt on the kernel command line. The GPT
+	  is still checked by the regular EFI validator. Without an
+	  exact factory map, BigPart partition discovery fails closed.
+	  Do not use a standard recovery image to write these partitions.
+
 config SYSV68_PARTITION
 	bool "SYSV68 partition table support" if PARTITION_ADVANCED
 	default y if VME
diff --git a/block/partitions/efi.c b/block/partitions/efi.c
index 9865d5909..4c8b91d24 100644
--- a/block/partitions/efi.c
+++ b/block/partitions/efi.c
@@ -87,9 +87,59 @@
 #include <linux/ctype.h>
 #include <linux/math64.h>
 #include <linux/slab.h>
+#ifdef CONFIG_MOTOROLA_XOOM_BIGPART
+#include <linux/device.h>
+#include <linux/of.h>
+#endif
 #include "check.h"
 #include "efi.h"
 
+#ifdef CONFIG_MOTOROLA_XOOM_BIGPART
+/*
+ * Reinterpret the old Motorola GPT only on explicitly opted-in devices.
+ * Tegra20 already supports the relocated GPT via alternative_gpt_sector;
+ * do not provide another sector override or bypass GPT CRC validation.
+ */
+static bool xoom_bigpart_requested;
+
+static int __init xoom_bigpart_setup(char *arg)
+{
+	if (kstrtobool(arg, &xoom_bigpart_requested))
+		return 0;
+
+	return 1;
+}
+__setup("xoom_bigpart=", xoom_bigpart_setup);
+
+static bool xoom_bigpart_geometry(struct parsed_partitions *state)
+{
+	return xoom_bigpart_requested &&
+		of_machine_is_compatible("motorola,stingray") &&
+		get_capacity(state->disk) == 62521344ULL &&
+		queue_logical_block_size(state->disk->queue) == 512;
+}
+
+static bool xoom_bigpart_emmc(struct parsed_partitions *state)
+{
+	struct device *dev;
+	u32 base;
+
+	for (dev = disk_to_dev(state->disk); dev; dev = dev->parent) {
+		struct device_node *np = dev->of_node;
+
+		if (!np || !of_device_is_compatible(np, "nvidia,tegra20-sdhci") ||
+		    !of_property_read_bool(np, "non-removable"))
+			continue;
+
+		if (!of_property_read_u32(np, "reg", &base) &&
+		    base == 0xc8000600)
+			return true;
+	}
+
+	return false;
+}
+#endif
+
 /* This allows a kernel command line option 'gpt' to override
  * the test for invalid PMBR.  Not __initdata because reloading
  * the partition tables happens after init too.
@@ -709,18 +759,91 @@ static void utf16_le_to_7bit(const __le16 *in, unsigned int size, u8 *out)
  *  1 if successful
  *
  */
+#ifdef CONFIG_MOTOROLA_XOOM_BIGPART
+/*
+ * The validated factory GPT remains unchanged on disk. The original
+ * BigPart layout only changes the in-kernel extents of entries 8..10.
+ */
+static bool xoom_bigpart_factory_gpt(struct parsed_partitions *state,
+				     const gpt_header *gpt, const gpt_entry *ptes)
+{
+	static const u64 starts[] = {
+		51200, 57344, 61440, 65536, 73728, 77824, 102400,
+		118784, 643072, 989184
+	};
+	static const u64 sizes[] = {
+		6144, 4096, 4096, 8192, 4096, 24576, 16384,
+		524288, 346112, 61522944
+	};
+	u64 disk_end = last_lba(state->disk);
+	u32 n = le32_to_cpu(gpt->num_partition_entries);
+	u32 i;
+
+	if (n < ARRAY_SIZE(starts) || state->limit <= ARRAY_SIZE(starts))
+		return false;
+
+	for (i = 0; i < n; i++) {
+		u64 start, end;
+
+		if (i >= ARRAY_SIZE(starts)) {
+			if (efi_guidcmp(ptes[i].partition_type_guid, NULL_GUID))
+				return false;
+			continue;
+		}
+
+		if (!is_pte_valid(&ptes[i], disk_end))
+			return false;
+
+		start = le64_to_cpu(ptes[i].starting_lba);
+		end = le64_to_cpu(ptes[i].ending_lba);
+		if (start != starts[i] || end < start ||
+		    end - start + 1 != sizes[i])
+			return false;
+	}
+
+	return true;
+}
+#endif
+
 int efi_partition(struct parsed_partitions *state)
 {
 	gpt_header *gpt = NULL;
 	gpt_entry *ptes = NULL;
+#ifdef CONFIG_MOTOROLA_XOOM_BIGPART
+	bool bigpart = xoom_bigpart_geometry(state);
+	bool bigpart_emmc = xoom_bigpart_requested &&
+		of_machine_is_compatible("motorola,stingray") &&
+		xoom_bigpart_emmc(state);
+#endif
 	u32 i;
 	unsigned ssz = queue_logical_block_size(state->disk->queue) / 512;
 
+#ifdef CONFIG_MOTOROLA_XOOM_BIGPART
+	/* Never expose stock extents after an explicit matching opt-in. */
+	if (bigpart != bigpart_emmc) {
+		pr_err("Xoom BigPart: refused unexpected eMMC geometry or controller\n");
+		return -1;
+	}
+#endif
 	if (!find_valid_gpt(state, &gpt, &ptes) || !gpt || !ptes) {
 		kfree(gpt);
 		kfree(ptes);
+#ifdef CONFIG_MOTOROLA_XOOM_BIGPART
+		if (bigpart) {
+			pr_err("Xoom BigPart: valid factory GPT not found\n");
+			return -1;
+		}
+#endif
 		return 0;
 	}
+#ifdef CONFIG_MOTOROLA_XOOM_BIGPART
+	if (bigpart && !xoom_bigpart_factory_gpt(state, gpt, ptes)) {
+		pr_err("Xoom BigPart: refusing unexpected GPT layout\n");
+		kfree(gpt);
+		kfree(ptes);
+		return -1;
+	}
+#endif
 
 	pr_debug("GUID Partition Table is valid!  Yea!\n");
 
@@ -734,6 +857,24 @@ int efi_partition(struct parsed_partitions *state)
 		if (!is_pte_valid(&ptes[i], last_lba(state->disk)))
 			continue;
 
+#ifdef CONFIG_MOTOROLA_XOOM_BIGPART
+		if (bigpart) {
+			switch (i) {
+			case 7:
+				start = 118784;
+				size = 2097152;
+				break;
+			case 8:
+				start = 2215936;
+				size = 1048576;
+				break;
+			case 9:
+				start = 3264512;
+				size = 59247616;
+				break;
+			}
+		}
+#endif
 		put_partition(state, i+1, start * ssz, size * ssz);
 
 		/* If this is a RAID volume, tell md */
-- 
2.34.1

