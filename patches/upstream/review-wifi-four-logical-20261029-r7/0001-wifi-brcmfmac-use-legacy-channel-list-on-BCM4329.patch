From 03aa8212d60dc2e585a40a748749d6a324538401 Mon Sep 17 00:00:00 2001
From: XoomLinux7 RFC draft <rfc-draft@invalid.example>
Date: Tue, 27 Oct 2026 20:49:33 -0400
Subject: [PATCH 1/4] wifi: brcmfmac: use legacy channel list on BCM4329

Some older BCM4329 firmware rejects the 'chanspecs' iovar with
BCME_UNSUPPORTED, while WLC_GET_VALID_CHANNELS returns valid
firmware channel numbers. Without a fallback, the advertised wiphy
channels are incomplete and ordinary 2.4/5 GHz scans fail.

On precisely that firmware error and chipset, consume the bounded
legacy channel list. Disable channels not reported by firmware and
constrain bandwidth to 20 MHz. For allowed 20 MHz channels, query
the optional firmware per_chan_info restrictions, as the normal
chanspec path does, and add radar/passive flags when supported.
Never enable a channel or clear cfg80211 restrictions. Do not alter
the normal chanspec path or any other Broadcom device.

A BCM4329 V31 laboratory build with related legacy fallback completed
normal scans, WPA2 and internet access on a Motorola Xoom MZ600.
This cleaned source variant requires its own physical validation.

Assisted-by: ChatGPT:GPT-6 [Desktop Commander]
On firmware without per_chan_info, retain fail-closed NO_IR on
5 GHz channels and avoid repeating unsupported IOCTLs. This is
not a country override or permission to transmit.
---
 .../broadcom/brcm80211/brcmfmac/cfg80211.c    | 212 +++++++++++++++++-
 .../broadcom/brcm80211/brcmfmac/fwil.c        |  65 ++++--
 .../broadcom/brcm80211/brcmfmac/fwil.h        |   4 +
 3 files changed, 261 insertions(+), 20 deletions(-)

diff --git a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/cfg80211.c b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/cfg80211.c
index 0b55d4458..fc895433c 100644
--- a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/cfg80211.c
+++ b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/cfg80211.c
@@ -6992,6 +6992,175 @@ static void brcmf_update_bw40_channel_flag(struct ieee80211_channel *channel,
 	}
 }
 
+/* Broadcom's BCME_UNSUPPORTED is 23. Linux fwil collapses vendor errors
+ * to -EBADE, so the fallback must inspect the actual firmware status.
+ */
+#define BRCMF_BCM4329_FW_UNSUPPORTED	23
+
+/* Older BCM4329 firmware exposes a channel-number list, not 'chanspecs'.
+ * Keep existing cfg80211 restrictions and assume only 20 MHz support.
+ */
+static int brcmf_bcm4329_legacy_channels(struct brcmf_cfg80211_info *cfg,
+					 u8 *pbuf)
+{
+	struct brcmf_pub *drvr = cfg->pub;
+	struct brcmf_if *ifp = brcmf_get_ifp(drvr, 0);
+	struct wiphy *wiphy = cfg_to_wiphy(cfg);
+	struct brcmf_chanspec_list *list = (void *)pbuf;
+	struct ieee80211_supported_band *band;
+	struct ieee80211_channel *channel;
+	struct brcmu_chan ch = {};
+	u32 count, max_count, chan, chaninfo, flags, i, j, k;
+	u32 *restrictions;
+	size_t n_channels = 0, slot = 0;
+	bool supported, per_chan_available = true;
+	s32 fwerr;
+	int err, chan_err;
+
+	max_count = (BRCMF_DCMD_MEDLEN - sizeof(list->count)) /
+		    sizeof(list->element[0]);
+	memset(pbuf, 0, BRCMF_DCMD_MEDLEN);
+	list->count = cpu_to_le32(max_count);
+	err = brcmf_fil_cmd_data_get(ifp, BRCMF_C_GET_VALID_CHANNELS,
+				     pbuf, BRCMF_DCMD_MEDLEN);
+	if (err)
+		return err;
+
+	count = le32_to_cpu(list->count);
+	if (!count || count > max_count)
+		return -EINVAL;
+	for (i = 0; i < count; i++) {
+		chan = le32_to_cpu(list->element[i]);
+		if (!((chan >= 1 && chan <= 14) ||
+		      (chan >= 30 && chan <= 196)))
+			return -EINVAL;
+	}
+
+	for (i = 0; i < NUM_NL80211_BANDS; i++) {
+		band = wiphy->bands[i];
+		if (band && (i == NL80211_BAND_2GHZ ||
+			     i == NL80211_BAND_5GHZ))
+			n_channels += band->n_channels;
+	}
+	if (!n_channels)
+		return -EINVAL;
+
+	/* Stage all restrictions before changing a live cfg80211 channel:
+	 * optional firmware-query failure must not leave a partial table.
+	 */
+	restrictions = kcalloc(n_channels, sizeof(*restrictions), GFP_KERNEL);
+	if (!restrictions)
+		return -ENOMEM;
+
+	for (i = 0; i < NUM_NL80211_BANDS; i++) {
+		band = wiphy->bands[i];
+		if (!band || (i != NL80211_BAND_2GHZ &&
+			      i != NL80211_BAND_5GHZ))
+			continue;
+		for (j = 0; j < band->n_channels; j++) {
+			channel = &band->channels[j];
+			supported = false;
+			for (k = 0; k < count; k++) {
+				if (channel->hw_value ==
+				    le32_to_cpu(list->element[k])) {
+					supported = true;
+					break;
+				}
+			}
+			if (!supported) {
+				restrictions[slot++] = IEEE80211_CHAN_DISABLED;
+				continue;
+			}
+			if (channel->orig_flags & IEEE80211_CHAN_DISABLED) {
+				slot++;
+				continue;
+			}
+
+			flags = IEEE80211_CHAN_NO_HT40 |
+				IEEE80211_CHAN_NO_80MHZ |
+				IEEE80211_CHAN_NO_160MHZ;
+			if (per_chan_available) {
+				ch.chnum = channel->hw_value;
+				ch.band = (band->band == NL80211_BAND_2GHZ) ?
+					BRCMU_CHAN_BAND_2G : BRCMU_CHAN_BAND_5G;
+				ch.bw = BRCMU_CHAN_BW_20;
+				ch.sb = BRCMU_CHAN_SB_NONE;
+				cfg->d11inf.encchspec(&ch);
+				chaninfo = cpu_to_le32(ch.chspec);
+				fwerr = 0;
+				chan_err = brcmf_fil_bsscfg_data_get_fwerr(ifp,
+					"per_chan_info", &chaninfo,
+					sizeof(chaninfo), &fwerr);
+				if (!chan_err) {
+					chaninfo = le32_to_cpu(chaninfo);
+					if (chaninfo & WL_CHAN_RADAR)
+						flags |= IEEE80211_CHAN_RADAR |
+							 IEEE80211_CHAN_NO_IR;
+					if (chaninfo & WL_CHAN_PASSIVE)
+						flags |= IEEE80211_CHAN_NO_IR;
+				} else if (fwerr ==
+					   -BRCMF_BCM4329_FW_UNSUPPORTED) {
+					per_chan_available = false;
+				} else {
+					err = chan_err;
+					goto out_free;
+				}
+			} else {
+				chan_err = -EOPNOTSUPP;
+			}
+
+			/* No trusted per-channel passive/DFS metadata. Keep
+			 * the legacy firmware's uncertain 5 GHz channels NO_IR,
+			 * in addition to (never instead of) cfg80211 limits.
+			 */
+			if (chan_err && band->band == NL80211_BAND_5GHZ)
+				flags |= IEEE80211_CHAN_NO_IR;
+			restrictions[slot++] = flags;
+		}
+	}
+
+	/* Commit only after every firmware query has succeeded or has
+	 * returned the proven native BCME_UNSUPPORTED result. Never
+	 * clear a restriction supplied by cfg80211.
+	 */
+	slot = 0;
+	for (i = 0; i < NUM_NL80211_BANDS; i++) {
+		band = wiphy->bands[i];
+		if (!band || (i != NL80211_BAND_2GHZ &&
+			      i != NL80211_BAND_5GHZ))
+			continue;
+		for (j = 0; j < band->n_channels; j++)
+			band->channels[j].flags |= restrictions[slot++];
+	}
+	err = 0;
+
+out_free:
+	kfree(restrictions);
+	return err;
+}
+
+/* Reapply only the firmware's legacy restrictions following a regulatory
+ * no-op. A BCM4329 with modern "chanspecs" must retain its normal path.
+ */
+static int brcmf_bcm4329_refresh_legacy_channels(struct brcmf_cfg80211_info *cfg)
+{
+	struct brcmf_if *ifp = brcmf_get_ifp(cfg->pub, 0);
+	u8 *pbuf;
+	s32 fwerr = 0;
+	int err;
+
+	pbuf = kzalloc(BRCMF_DCMD_MEDLEN, GFP_KERNEL);
+	if (!pbuf)
+		return -ENOMEM;
+
+	err = brcmf_fil_iovar_data_get_fwerr(ifp, "chanspecs", pbuf,
+					      BRCMF_DCMD_MEDLEN, &fwerr);
+	if (err && fwerr == -BRCMF_BCM4329_FW_UNSUPPORTED)
+		err = brcmf_bcm4329_legacy_channels(cfg, pbuf);
+	kfree(pbuf);
+	return err;
+}
+
 static int brcmf_construct_chaninfo(struct brcmf_cfg80211_info *cfg,
 				    u32 bw_cap[])
 {
@@ -7007,6 +7176,7 @@ static int brcmf_construct_chaninfo(struct brcmf_cfg80211_info *cfg,
 	u32 i, j;
 	u32 total;
 	u32 chaninfo;
+	s32 fwerr = 0;
 
 	pbuf = kzalloc(BRCMF_DCMD_MEDLEN, GFP_KERNEL);
 
@@ -7015,10 +7185,19 @@ static int brcmf_construct_chaninfo(struct brcmf_cfg80211_info *cfg,
 
 	list = (struct brcmf_chanspec_list *)pbuf;
 
-	err = brcmf_fil_iovar_data_get(ifp, "chanspecs", pbuf,
-				       BRCMF_DCMD_MEDLEN);
+	if (drvr->bus_if->chip == BRCM_CC_4329_CHIP_ID)
+		err = brcmf_fil_iovar_data_get_fwerr(ifp, "chanspecs",
+						pbuf, BRCMF_DCMD_MEDLEN,
+						&fwerr);
+	else
+		err = brcmf_fil_iovar_data_get(ifp, "chanspecs", pbuf,
+						BRCMF_DCMD_MEDLEN);
 	if (err) {
-		bphy_err(drvr, "get chanspecs error (%d)\n", err);
+		if (drvr->bus_if->chip == BRCM_CC_4329_CHIP_ID &&
+		    fwerr == -BRCMF_BCM4329_FW_UNSUPPORTED)
+			err = brcmf_bcm4329_legacy_channels(cfg, pbuf);
+		else
+			bphy_err(drvr, "get chanspecs error (%d)\n", err);
 		goto fail_pbuf;
 	}
 
@@ -8269,12 +8448,37 @@ static void brcmf_cfg80211_reg_notifier(struct wiphy *wiphy,
 	}
 
 	err = brcmf_translate_country_code(ifp->drvr, req->alpha2, &ccreq);
-	if (err)
+	if (err) {
+		/* A no-op or unavailable country translation leaves the
+		 * firmware's current channel list in force. cfg80211 may
+		 * have just recalculated flags; reapply the legacy limits.
+		 */
+		if (drvr->bus_if->chip == BRCM_CC_4329_CHIP_ID) {
+			int refresh_err;
+
+			refresh_err = brcmf_bcm4329_refresh_legacy_channels(cfg);
+			if (refresh_err)
+				bphy_err(drvr, "BCM4329 legacy channel refresh failed (%d)\n",
+					 refresh_err);
+		}
 		return;
+	}
 
 	err = brcmf_fil_iovar_data_set(ifp, "country", &ccreq, sizeof(ccreq));
 	if (err) {
 		bphy_err(drvr, "Firmware rejected country setting\n");
+		/* Firmware may still use its old country after cfg80211
+		 * has updated channel flags. Intersect with the current
+		 * firmware list again on legacy BCM4329 only.
+		 */
+		if (drvr->bus_if->chip == BRCM_CC_4329_CHIP_ID) {
+			int refresh_err;
+
+			refresh_err = brcmf_bcm4329_refresh_legacy_channels(cfg);
+			if (refresh_err)
+				bphy_err(drvr, "BCM4329 rejected-country refresh failed (%d)\n",
+					 refresh_err);
+		}
 		return;
 	}
 	brcmf_setup_wiphybands(cfg);
